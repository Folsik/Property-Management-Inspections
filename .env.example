APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://inspections:inspections_dev_password@localhost:5432/inspections?sslmode=disable
JWT_ISSUER=inspections-api
ACCESS_TOKEN_TTL=15m
# Required for production: base64url encoded Ed25519 64-byte private key
# JWT_PRIVATE_KEY=
# Optional S3-compatible storage, required to enable media uploads
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=inspection-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional production SMS delivery (required to authenticate without local dev OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Verified-email onboarding + team invitations via Resend (required in production).
# The sender must be a verified domain in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=
# Public HTTPS URL used in invitation emails (e.g. https://app.inspectly.example).
PUBLIC_WEB_URL=
